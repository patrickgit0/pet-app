{
  "name": "viralar",
  "private": true,
  "version": "0.1.0",
  "description": "Vira Lar — marketplace de adoção de cães e gatos (ONGs, adotantes, chat e pós-adoção)",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "lint:web": "npm run lint -w web",
    "test": "npm test -w @viralar/shared",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "supabase": "^3.2.0"
  }
}
